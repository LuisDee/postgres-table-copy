{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luisdee/postgres-table-copy/docs/schemas/plan.schema.json",
  "title": "pgcopy plan",
  "description": "Output of `pgcopy plan` — a reviewable, executable description of a copy job produced WITHOUT touching table data. `pgcopy run --plan FILE` consumes it. Lands in Wave 3 (docs/design.md §6). This is the canonical plan contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "created_at", "source", "target", "consistency", "budget", "tables"],
  "properties": {
    "job_id": { "type": "string", "pattern": "^j_[0-9]{8}_[0-9]{6}_[0-9a-z]{4}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "schema_version": { "type": "integer", "const": 1 },
    "source": { "$ref": "#/$defs/endpointRef" },
    "target": { "$ref": "#/$defs/endpointRef" },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["snapshot", "none"], "description": "snapshot = one exported source snapshot shared by all readers; none = best-effort." },
        "copy_format": { "enum": ["binary", "text"], "description": "Wire format; binary requires matching majors." }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_parallel", "max_chunks_per_table"],
      "properties": {
        "max_parallel": { "type": "integer", "minimum": 1 },
        "max_chunks_per_table": { "type": "integer", "minimum": 1 },
        "projected_peak_connections": { "type": "integer", "minimum": 1, "description": "leader + active workers; must stay under target max_connections / pool size." }
      }
    },
    "tables": {
      "type": "array",
      "items": { "$ref": "#/$defs/tablePlan" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" },
      "description": "Plan-time hazards (RLS filtering, LONG/large objects, collation/encoding drift, missing privilege, no-PK)."
    }
  },
  "$defs": {
    "endpointRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema"],
      "properties": {
        "name": { "type": "string", "description": "Endpoint name from the registry." },
        "schema": { "type": "string" },
        "server_version": { "type": "string" }
      }
    },
    "tablePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "name", "strategy"],
      "properties": {
        "schema": { "type": "string" },
        "name": { "type": "string" },
        "strategy": { "enum": ["direct_copy", "ctid_chunked", "key_range_chunked", "pgcopydb_delegate"] },
        "est_bytes": { "type": "integer", "minimum": 0 },
        "est_rows": { "type": "integer", "minimum": 0 },
        "chunks": { "type": "integer", "minimum": 1 },
        "columns": { "type": "array", "items": { "type": "string" }, "description": "Explicit column list (generated STORED columns excluded)." },
        "has_identity": { "type": "boolean" },
        "has_generated": { "type": "boolean" },
        "has_large_objects": { "type": "boolean" },
        "rls_enabled": { "type": "boolean" },
        "fk_parents": { "type": "array", "items": { "type": "string" } },
        "validation": { "enum": ["rows", "columns", "hash", "digest", "sample", "none"] }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "table", "message"],
      "properties": {
        "code": { "enum": ["RLS_FILTER", "NO_PK", "LARGE_OBJECTS", "COLLATION_DRIFT", "ENCODING_DRIFT", "MISSING_PRIVILEGE", "GENERATED_COLUMNS", "UNSUPPORTED_TYPE"] },
        "table": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
